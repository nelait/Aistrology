# Aistrology API server configuration. Copy to `.env` and fill in.

# Where the frontend runs (Vite). OAuth redirects and the post-login bounce go
# here. Must match the origin you open in the browser.
APP_URL=http://localhost:5173

# API server port (Vite proxies /api and /auth to it).
PORT=8787

# PostgreSQL connection string. Create the database first, e.g.:
#   createdb aistrology
DATABASE_URL=postgres://localhost:5432/aistrology

# Sign this to keep sessions secure. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Encrypts users' LLM API keys at rest. Use a long random string
# (falls back to SESSION_SECRET if unset). Changing it invalidates stored keys.
LLM_ENC_SECRET=change-me-to-another-long-random-string

# --- Google OAuth ---------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth ---------------------------------------------------------
# Register at https://github.com/settings/developers (New OAuth App)
# Authorization callback URL: <APP_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local, provider-less sign-in for development (set to "false" in production).
ALLOW_DEV_LOGIN=true

# --- Admin module --------------------------------------------------------
# The super-admin is seeded from these at startup and can NEVER be created
# through public registration. Admin login (a separate gate) requires the
# admin password AND the access code below, so a leaked password alone can't
# reach the admin area. Set all three to enable the admin module.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ACCESS_CODE=

# --- Reminder emails (optional) ------------------------------------------
# Reminders always reach users as in-app notifications. To ALSO send real
# email, set a Resend API key (https://resend.com) and a verified from-address.
# When unset, reminders are delivered in-app only and logged server-side.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=

# --- Stripe Billing -------------------------------------------------------
# Create an account at https://dashboard.stripe.com
# Get keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — get from `stripe listen --forward-to localhost:8787/api/billing/webhook`
# or from the Stripe Dashboard under Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Create Products + Prices in Stripe Dashboard, then paste the Price IDs here.
# Pro plan (e.g. ₹499/mo):
STRIPE_PRO_PRICE_ID=price_...
# Premium plan (e.g. ₹999/mo):
STRIPE_PREMIUM_PRICE_ID=price_...

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION (Railway) — set these as service Variables, not in a file.
# See docs/deployment.md. Validate with:  railway run npm run deploy:check
# ─────────────────────────────────────────────────────────────────────────────
# NODE_ENV=production
#   Enables single-origin static serving of dist/ and disables dev login.
#
# APP_URL=https://<your-app>.up.railway.app
#   Your public Railway domain, no trailing slash. OAuth redirects, the
#   post-login bounce and Stripe return URLs all use it.
#
# DATABASE_URL=${{Postgres.DATABASE_URL}}
#   Reference the Railway Postgres service. Prefer the private URL
#   (*.railway.internal) — it needs no TLS and doesn't leave the project network.
#
# ALLOW_DEV_LOGIN — leave UNSET in production. It is off by default there and
#   must be explicitly "true" to enable; never do that on a public deploy.
#
# SERVE_STATIC=false
#   Only if you host the frontend separately (CDN). Defaults on in production.
