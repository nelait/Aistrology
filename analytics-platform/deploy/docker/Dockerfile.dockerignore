# BuildKit reads <Dockerfile>.dockerignore next to the Dockerfile, so this
# applies to the analytics-platform/backend build context without adding
# files under backend/.
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/*.egg-info
**/.venv
**/venv
**/.data
**/.env
**/.env.*
build/
dist/
tests/
