# Copy to terraform.tfvars (git-ignored) and adjust.
project_id = "my-org-analytics-prod"
region     = "us-central1" # or europe-west1 for EU residency

name = "analytics"
env  = "prod"

k8s_namespace       = "analytics"
k8s_service_account = "analytics-platform"

master_authorized_networks = [
  { cidr_block = "203.0.113.0/24", display_name = "corp-vpn" },
]

db_tier             = "db-custom-2-7680"
secret_prefix       = "analytics"
jwt_secret_name     = "jwt-signing-key"
deletion_protection = true
